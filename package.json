    "autoprefixer": "^10.4.20",
    "cypress": "^13.14.2",
    "dotenv": "^17.3.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.41",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.1",
    "start-server-and-test": "^2.0.5",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.2",
