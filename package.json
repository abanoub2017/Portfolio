    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/vue-3": "^3.20.0",
    "@vueuse/core": "^10.11.1",
    "browser-image-compression": "^2.0.2",
    "firebase": "^12.9.0",
    "lowlight": "^3.3.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-gtag": "^3.7.0",
    "vue-router": "^4.4.3",
    "vue3-smooth-scroll": "^0.8.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
